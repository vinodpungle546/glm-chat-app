# Globant GAIA API credentials for the GLM-5.3-Flash chat app.
# Copy this file to .env and fill in real values: cp .env.example .env

# GAIA API base URL (no trailing slash)
GAIA_BASE_URL=

# GAIA API key (Bearer token)
GAIA_API_KEY=

# Model id as listed by the GAIA /v1/models endpoint
GAIA_MODEL=

# Full chat-completions endpoint (usually {GAIA_BASE_URL}/v1/chat/completions)
GAIA_ENDPOINT=

# --- Local (offline) models -------------------------------------------------
# Chat models run in Ollama natively on the Mac (scripts/start_local_ai.sh).
# Fallback local model for calls that don't name one. The model list and default are in
# models.json (default: Gemma 4 E4B); any model you `ollama pull` also appears in the picker.
LOCAL_LLM_MODEL=gemma4:e4b
# Optional: a different model for helper calls (memory extraction). Empty = same as chat model.
LOCAL_BACKGROUND_MODEL=
# Context Ollama allocates (keep in sync with scripts/start_local_ai.sh)
OLLAMA_CONTEXT_LENGTH=32768
# Measured speeds on this laptop, used for "this will take N min" notices
LOCAL_PREFILL_TPS=105
LOCAL_GEN_TPS=10

# --- Meeting transcription (local only, no cloud path) ---------------------
# Watch folder for recordings and where transcripts are saved (paths on the Mac)
MEETINGS_DIR_HOST=~/Meetings
TRANSCRIPTS_DIR_HOST=./data/transcripts

# --- Web app (scripts/start_app.sh) -------------------------------------------
# Ports for the Python API and the Next.js web app
API_PORT=8000
WEB_PORT=3000

# --- Cloud providers, connectors (optional) ---
# Claude / OpenAI / OpenAI-compatible keys are added in Settings → Models and stored in the macOS
# Keychain, not here. Connectors are found in Settings → Connectors (official MCP Registry).
# API_PUBLIC_URL=http://127.0.0.1:8000                       # where OAuth sign-ins return (connectors)
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io  # connector directory
