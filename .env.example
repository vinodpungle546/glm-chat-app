# Globant GAIA API credentials for the GLM-5.3-Flash chat app.
# Copy this file to .env and fill in real values: cp .env.example .env

# GAIA API base URL (no trailing slash)
GAIA_BASE_URL=

# GAIA API key (Bearer token)
GAIA_API_KEY=

# Model id as listed by the GAIA /v1/models endpoint
GAIA_MODEL=

# Full chat-completions endpoint (usually {GAIA_BASE_URL}/v1/chat/completions)
GAIA_ENDPOINT=
